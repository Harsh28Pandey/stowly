# ---- Server ----
NODE_ENV=development
PORT=5000
# Frontend URL (used for CORS). In dev the Vite server runs on 5173.
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Local MongoDB:      mongodb://127.0.0.1:27017/stowly
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stowly
MONGODB_URI=mongodb://127.0.0.1:27017/stowly

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# ---- First administrator (created automatically on first start) ----
ADMIN_NAME=Stowly Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# ---- Storage & Quota Settings ----
# Default Storage quota given to every user, in GB (Default: 500 GB)
STORAGE_QUOTA_GB=500
# Maximum size of a single upload, in MB
MAX_FILE_MB=500
# Folder where uploaded files are saved (local fallback)
UPLOAD_DIR=./uploads

# ---- Third-Party Storage Provider API Keys (Separate for Images, Videos, PDFs/Docs) ----
IMAGE_STORAGE_PROVIDER_API_KEY=img_provider_api_key_here
VIDEO_STORAGE_PROVIDER_API_KEY=vid_provider_api_key_here
DOCUMENT_STORAGE_PROVIDER_API_KEY=doc_provider_api_key_here
DEFAULT_STORAGE_PROVIDER_API_KEY=default_provider_api_key_here

# ---- Cloudinary Cloud Storage Integration ----
# Get these keys from https://cloudinary.com/console (Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Specialized Cloudinary Accounts / Bucket Keys per File Type
IMAGE_CLOUDINARY_CLOUD_NAME=
IMAGE_CLOUDINARY_API_KEY=
IMAGE_CLOUDINARY_API_SECRET=

VIDEO_CLOUDINARY_CLOUD_NAME=
VIDEO_CLOUDINARY_API_KEY=
VIDEO_CLOUDINARY_API_SECRET=

DOCUMENT_CLOUDINARY_CLOUD_NAME=
DOCUMENT_CLOUDINARY_API_KEY=
DOCUMENT_CLOUDINARY_API_SECRET=

